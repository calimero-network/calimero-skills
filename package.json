{
  "name": "@calimero-network/agent-skills",
  "version": "0.5.0",
  "description": "AI agent skills for Calimero 1.0 development — Rust SDK, JS and Python clients, meroctl, merod, operators, registry publishing, and more.",
  "keywords": [
    "calimero",
    "agent-skills",
    "ai",
    "tee",
    "raft",
    "wasm",
    "meroctl",
    "calimero-sdk"
  ],
  "homepage": "https://github.com/calimero-network/calimero-skills",
  "bugs": {
    "url": "https://github.com/calimero-network/calimero-skills/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/calimero-network/calimero-skills.git"
  },
  "license": "MIT",
  "bin": {
    "calimero-skills": "scripts/install.js"
  },
  "files": [
    "skills/",
    "SKILL.md",
    "scripts/",
    "README.md"
  ],
  "scripts": {
    "format": "prettier --write \"**/*.{md,json,js,ts}\"",
    "format:check": "prettier --check \"**/*.{md,json,js,ts}\"",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"!node_modules/**\" \"!CHANGELOG.md\"",
    "validate:content": "node scripts/validate-content.js",
    "check:versions": "node scripts/check-versions.js",
    "check:versions:latest": "CHECK_LATEST_CORE=1 node scripts/check-versions.js",
    "test": "node scripts/test.js && node scripts/test-install.js && node scripts/validate-content.js && node scripts/check-versions.js"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "js-yaml": "^4.2.0",
    "markdownlint-cli2": "^0.21.0",
    "prettier": "^3.3.3",
    "semantic-release": "^24.2.9"
  },
  "overrides": {
    "js-yaml": "^4.2.0",
    "markdown-it": "^14.2.0"
  }
}
